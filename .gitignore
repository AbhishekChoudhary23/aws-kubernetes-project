
# ==========================================
# Terraform
# ==========================================

# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# ==========================================
# Node.js
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# Environment variables and secrets
# ==========================================

.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ==========================================
# Operating System
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# IDE
# ==========================================

.vscode/
.idea/

check-my-quotas.sh
